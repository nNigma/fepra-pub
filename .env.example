# FePra — environment template.
# Copy to .env and fill in. .env is gitignored — never commit it.
# Values from the real environment override this file (see tj/config.py::load_dotenv).

# ── Telegram bot ────────────────────────────────────────────────
# Create a bot via @BotFather → /newbot → copy the token here.
TG_FEPRA_BOT_TOKEN=
# Optional second bot for local testing (own token from @BotFather). Leave empty if unused.
TG_FEPRA_DEV_BOT_TOKEN=

# Owner Telegram user id (the account that becomes admin / data owner).
# Find yours by messaging @userinfobot. Required for single-user backfill and admin.
OWNER_TG_ID=

# Bot @username without "@" — used for t.me deep links from the web UI.
BOT_USERNAME=

# ── Web: Mini App + PWA (FastAPI) ───────────────────────────────
# Public HTTPS origin of the service. Builds invite links, watch/Whoop callbacks
# and is the passkey (WebAuthn) relying party — must match the URL users open.
FEPRA_PUBLIC_URL=https://fepra.example
# URL the bot opens as the Telegram Mini App (usually the same origin).
MINIAPP_URL=https://fepra.example
# Local port uvicorn listens on (reverse-proxy target). Default 8010.
TJAPP_PORT=8010

# ── Gemini (Google) — LLM text + vision ─────────────────────────
# Free key for text analysis. Get one at https://aistudio.google.com/apikey
# NOTE: Gemini API is blocked from some regions (e.g. RU) — host where it is reachable.
GEMINI_API_KEY=
# Paid key used for photo/vision recognition (WOD board). Falls back to GEMINI_API_KEY.
GEMINI_COST_API_KEY=
# Optional model override (default: gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# ── Claude (Anthropic) — optional, only if [llm].use_claude = true ───────
# Two ways to enable Claude (see config.toml [llm].use_claude):
#   1) Install & log in Claude Code CLI (subscription) — nothing to set here.
#   2) OR set an Anthropic API key below (text reviews only; photo OCR stays on Gemini).
# Leave empty for the default Gemini-only setup.
ANTHROPIC_API_KEY=
# Optional model override for the API path (default: claude-sonnet-5).
# ANTHROPIC_MODEL=claude-sonnet-5
# Text-review engine order: "claude" (default; Claude if enabled, else Gemini) or
# "agent" — an external inference helper script (opt-in, needs FEPRA_AGENT_HELPER).
FEPRA_LLM_ENGINE=claude
# FEPRA_AGENT_HELPER=/path/to/infer.sh
# FEPRA_AGENT_USER=

# ── Web Push (PWA notifications) ────────────────────────────────
# Generate a pair: PYTHONPATH=src .venv/bin/python -m tj.services.push_cli gen-keys
# Without keys push is silently disabled.
FEPRA_VAPID_PRIVATE=
FEPRA_VAPID_PUBLIC=
FEPRA_VAPID_SUBJECT=mailto:you@example.com

# ── Garmin Connect (unofficial, via garminconnect) ──────────────
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=changeme
# Directory to cache the Garmin OAuth token so you don't log in every run.
GARMIN_TOKENSTORE=~/.garminconnect

# ── Universe gym feed (optional Telethon userbot) ───────────────
# Only if you ingest a coach's Telegram thread as the gym program source.
# API id/hash from https://my.telegram.org → API development tools.
TG_API_ID=
TG_API_HASH=
UNIVERSE_CHAT_ID=
UNIVERSE_TOPIC_ID=

# ── Watches: Samsung / Apple companions ─────────────────────────
# Where the bot sends users for the Android companion APK (Samsung / Health Connect).
# Defaults to FEPRA_PUBLIC_URL + /fepra-connect.apk — host the built APK there, or override:
# FEPRA_APK_URL=
# Endpoint for Apple Health Auto Export (defaults to FEPRA_PUBLIC_URL + /ingest/apple):
# FEPRA_APPLE_URL=

# ── Whoop (OAuth app from developer.whoop.com) ──────────────────
# Redirect URI in the Whoop app settings must be FEPRA_PUBLIC_URL + /whoop/callback.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Override only if the callback lives on another host:
# WHOOP_REDIRECT_URI=
