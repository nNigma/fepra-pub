# systemd unit for the FastAPI Mini App (uvicorn).
# Copy to /etc/systemd/system/kuznitsa-app.service, adjust paths, then:
#   systemctl daemon-reload && systemctl enable --now kuznitsa-app
[Unit]
Description=Kuznitsa Mini App (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/kuznitsa
Environment=PYTHONPATH=src
Environment=TJAPP_PORT=8010
ExecStart=/opt/kuznitsa/.venv/bin/python -m tjapp.server
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
