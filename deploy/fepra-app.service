# systemd unit for the FastAPI Mini App (uvicorn).
# Copy to /etc/systemd/system/fepra-app.service, adjust paths, then:
#   systemctl daemon-reload && systemctl enable --now fepra-app
[Unit]
Description=FePra Mini App (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/fepra
Environment=PYTHONPATH=src
# FEPRA_PUBLIC_URL, VAPID keys etc. are read from the process environment:
EnvironmentFile=-/opt/fepra/.env
Environment=TJAPP_PORT=8010
ExecStart=/opt/fepra/.venv/bin/python -m tjapp.server
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
